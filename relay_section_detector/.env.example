# Copy to .env and fill in values. Keys are read by pydantic-settings (see config.py).

# Input PDF (optional if you pass a path on the CLI)
RELAY_PDF_PATH=samples/report.pdf

# Line numbering / chunking
RELAY_LINE_PAD=4
RELAY_CHUNK_LINES=200
RELAY_CHUNK_OVERLAP=40

# OpenAI-compatible API (OpenAI, Azure OpenAI, Gemini OpenAI bridge, etc.)
RELAY_LLM_API_KEY=sk-your-key-here
RELAY_LLM_BASE_URL=https://api.openai.com/v1
RELAY_LLM_MODEL=gpt-4o-mini
RELAY_LLM_TEMPERATURE=0.1
RELAY_LLM_MAX_TOKENS=4096

# Optional overrides
RELAY_OUTPUT_DIR=output
RELAY_SAMPLES_DIR=samples
